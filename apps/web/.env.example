# Copy to .env.local. Values for the local stack are printed by `pnpm db:start`.
# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Character asset (converted from Mixamo, not in git). Optional override; by default the app
# reads /api/assets/characters/ (private Blob store, or the local copy in public/ without one).
NEXT_PUBLIC_CHARACTER_ASSETS_URL=
# Private Vercel Blob store (server only). Needed locally to upload the assets.
BLOB_READ_WRITE_TOKEN=
# Bump (v2, v3…) with every reconversion: the CDN caches a version forever.
CHARACTER_ASSETS_VERSION=v2
