# Copy to .env.local. Values for the local stack are printed by `pnpm db:start`.
# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Character asset (converted from Mixamo, not in git). Defaults to /assets/characters/ (local).
# On Vercel: /api/assets/characters/ (served from the private Blob store).
NEXT_PUBLIC_CHARACTER_ASSETS_URL=
# Private Vercel Blob store (server only). Needed locally to upload the assets.
BLOB_READ_WRITE_TOKEN=
CHARACTER_ASSETS_VERSION=v1
